 *
 * scos_config.h -- GENERATED FILE, do not edit.
 * Generated by CMake from include/os/scos_config.h.in.
 *
 * Every number here is a SIMULATOR DEFAULT chosen to be a plausible secure-MCU
 * budget. None of these values describes any real, specific chip. Change them
 * with -DSCOS_SIM_RAM_KB=... etc. at configure time.
 */
#ifndef SCOS_CONFIG_H
#define SCOS_CONFIG_H

#define SCOS_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define SCOS_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define SCOS_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define SCOS_VERSION_STRING "@PROJECT_VERSION@"

/* Virtual chip memory budgets (kilobytes). */
#define SCOS_RAM_KB    @SCOS_SIM_RAM_KB@
#define SCOS_ROM_KB    @SCOS_SIM_ROM_KB@
#define SCOS_EEPROM_KB @SCOS_SIM_EEPROM_KB@
#define SCOS_FLASH_KB  @SCOS_SIM_FLASH_KB@

#define SCOS_RAM_BYTES    (SCOS_RAM_KB    * 1024u)
#define SCOS_ROM_BYTES    (SCOS_ROM_KB    * 1024u)
#define SCOS_EEPROM_BYTES (SCOS_EEPROM_KB * 1024u)
#define SCOS_FLASH_BYTES  (SCOS_FLASH_KB  * 1024u)

/* Portion of RAM the OS working set is allowed to occupy. The remainder is
 * reserved for future applet RAM, crypto scratch and the transaction journal
 * cache. Enforced by a _Static_assert in include/os/kernel.h. */
#define SCOS_OS_RAM_BUDGET_BYTES (SCOS_RAM_BYTES / 2u)

/* Largest short-form command APDU: CLA INS P1 P2 Lc <255 data> Le = 261. */
#define SCOS_APDU_CMD_MAX 261u
/* Largest short-form response: 256 data bytes + SW1 SW2. */
#define SCOS_APDU_RSP_MAX 258u

/*
 * Response data waiting to be collected by GET RESPONSE.
 *
 * 256 because that is the most a short-form Le can ask for, and because SW2 of
 * a 61XX carries the remaining count in one byte -- 00 meaning 256. A larger
 * buffer could not be announced.
 *
 * Extended APDUs will need a bigger one, and that is exactly the point at
 * which the RAM budget starts to bite: 65535 bytes does not fit in 8 KB, so
 * extended-length support will have to chain rather than buffer. Better to
 * meet that constraint here than to discover it on the chip.
 */
#define SCOS_PENDING_MAX 256u

#endif /* SCOS_CONFIG_H */
